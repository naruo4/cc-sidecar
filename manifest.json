{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.5.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/naruo4/cc-sidecar",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "sidePanel",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionActionTitle__"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "__MSG_extensionShortName__",
  "author": "naruo4"
}
